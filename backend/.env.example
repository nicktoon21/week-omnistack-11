# Ambiente: development | test | production
NODE_ENV=development

# Porta da API
PORT=3333

# Origem permitida pelo CORS (URL do frontend)
CORS_ORIGIN=http://localhost:5173

# Segredo de assinatura dos tokens JWT.
# Obrigatório em produção. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# SQLite (development/test)
DATABASE_FILENAME=./src/database/db.sqlite

# PostgreSQL (production) — ex.: postgres://user:senha@host:5432/banco
DATABASE_URL=

# Quantidade de casos por página
PAGE_SIZE=5
